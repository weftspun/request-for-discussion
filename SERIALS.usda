            custom string sectionNote = "A deleted serial keeps its row. The RFDs above still cite it, and deleting a directory does not delete a citation."

            def "Retired"
            {
                custom string[] columns = ["serial int16 PK", "recorded_in int16 FK"]
                custom uniform token kind = "satellite"
                custom string primaryKey = "serial"

                def "S1024"
