#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        string arc = "1.3.6.1.4.1.66606.1.1"
        string category = "1"
        string categoryName = "documents"
        string pen = "1.3.6.1.4.1.66606"
        string[] relationKindVocabulary = ["spine", "satellite"]
        string rule = "1000-conventions/DETAILS.md"
        string site = "1"
        string siteName = "weftspun"
    }
    defaultPrim = "Serials"
)

def Scope "Serials"
{
    def Scope "Weftspun"
    {
        custom string thesis = "Every serial this site has allocated, and every one it has retired. A serial is appended once. It is never removed and never reused, because it is the last arc of an OID and an arc names one document for as long as it exists. A slug follows its directory, because a retitle renames a document and does not renumber it."

        def Scope "Allocated"
        {
            def "Rfd"
            {
                custom string[] columns = ["serial int16 PK", "slug string"]
                custom uniform token kind = "spine"
                custom string primaryKey = "serial"
                custom int[] serial = [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1023, 1025, 1026, 1027, 1028, 1029, 1030, 1031, 1033, 1034, 1035, 1036, 1037, 1038, 1039, 1040, 1041, 1042, 1043, 1044, 1045, 1046, 1047, 1048, 1049, 1050, 1051, 1052, 1053, 1054, 1055, 1056, 1057, 1058, 1059, 1060, 1061, 1062, 1063, 1064, 1065, 1066, 1067, 1070, 1073, 1074, 1075, 1076, 1077, 1078, 1079, 1080, 1082, 1083, 1084, 1085, 1086, 1087, 1088, 1089, 1090, 1091, 1092, 1093, 1094, 1095, 1096, 1098, 1099, 1100, 1101, 1102, 1103, 1104, 1105, 1106, 1107, 1108, 1109, 1110, 1111, 1112, 1113, 1114, 1115, 1116, 1117, 1118, 1119, 1120, 1121, 1122, 1123, 1124, 1125, 1126, 1128, 1129, 1130, 1131, 1132, 1133, 1134, 1135, 1136, 1137, 1138, 1139, 1140, 1141, 1142, 1143, 1144, 1145, 1146]
                custom string[] slug = ["conventions", "app-shell-and-routing", "studio-pipeline-graph", "task-manager-job-lifecycle", "aigc-task-catalog", "avatar-and-vrm-pipeline", "layer-decomposition-see-through", "motion-validation-kimodo", "appearance-trait-extraction-and-remix", "viewport-and-scene-rendering", "webxr-and-iwsdk-lab", "spatial-fabric-publish", "wallet-minting-and-x402", "public-demo-deploy", "batch-processing", "phygital-passport", "deep-learning-model-inventory", "fork-rebrand-to-weftspun", "m3-documentation-removal", "strangler-fig-studio-core", "cockroachdb-persistence", "shared-hrr-library", "hexagonal-client", "ports-and-adapters-with-headless-cms-style", "model-memory-arithmetic", "bf16-memory-per-model", "gpu-residency-budget", "model-license-gate", "foss-model-replacements", "seethrough-component-models", "geometry-refinement-and-alpha-wrap", "geometric-algorithms", "krea-memory-cross-check", "legacy-model-identifiers", "packaging-convention", "composite-models-as-taskweft-domains", "trellis2-image-to-textured-mesh", "trellis2-image-mesh-painting", "pixal3d-image-to-textured-mesh", "p3sam-mesh-segmentation", "krea2-turbo-text-to-image", "qwen-image-edit", "seethrough-layer-decomposition", "kimodo-text-to-motion", "skintokens-auto-rig", "voxhammer-text-mesh-editing", "voxhammer-image-mesh-editing", "weftspun-image-to-world", "lingbot-map-environment-scan", "worldmirror2-reconstruct", "triposplat-image-to-splat", "openusd-as-the-internal-format", "headless-cms-on-taskweft", "beam-workers-local-first", "develop-in-a-dev-container", "open-work", "zero-trust-networking", "continuous-integration", "thirdparty-reset", "glb-upload-prep-via-idtx-core", "flyio-toplevel-4090-worker-split", "ste-enforcement-moves-to-the-plugin", "character-concept-generator", "taskweft-domain-schema-in-etnf", "differential-mamba-for-caption-encoding", "cockroachdb-reranked-against-foundationdb", "keep-options-open", "dataset-billboard-gallery", "3d-billboard-labels", "github-oauth-admin-login", "usd-viewer-app-build-integration", "h2o-edge-cdn", "h2o-fdb-game-state-server", "appsignal-observability", "fly-deploy-cost", "android-studio-ai-brief", "api-avatar-rig-contract", "avatar-pipeline", "code-map", "dev-machine-topology", "gemini", "https-setup", "hyworld-image-to-world-scope", "iwsdk-integration", "iwsdk-local-fork", "kimodo-backend-integration", "loot-assets-setup", "multi-image-splat-roadmap", "nvidia-xr-ai-integration", "openxr-face-tracking-android-xr", "public-deploy", "scripts-cheatsheet", "spatial-fabric-integration", "ssh-host-names", "supported-3daigc-modules", "vercel-loot-assets", "vrm-upload-display-export", "webcam-avatar-control", "weftspun-moat-overview", "world-package", "xr-mode-floor-anchoring-and-backgrounds", "moat-payment-rails-and-phygital-registry", "reporesident-agent-harness", "3daigc-api-reference-not-restated", "cursor-rules-kept-in-the-open", "image-preview-vs-expand-sizing", "app-chrome-layout-invariants", "vrm-animation-playback-invariants", "tasks-panel-clear-and-collapse", "text-to-image-to-3d-chain", "xr-embody-locomotion-and-menu", "generic-hardware-not-dgx-or-android-xr-specific", "split-apps-into-own-repos", "layers-from-geometry-and-the-missing-categories", "the-wholebody-gap", "cineform-in-godot", "rfd-structure-gate", "two-prose-gates", "feed-forward-for-the-edge", "four-bit-tolerance", "hailo-operator-coverage", "ugen300-throughput", "operator-emulation-for-the-accelerator", "priority-list-of-converted-models", "models-excluded-from-conversion", "notebooks-tested-in-the-browser", "one-environment-per-elixir-app", "camera-vocabulary-and-the-96-pose-grid", "encoding-a-frame-set", "where-range-of-motion-comes-from", "conventions-are-measured", "rented-gpus-on-runpod", "publishing-artifacts", "the-mac-against-the-ugen300", "keypoints-to-anny", "image-to-omnigen2", "stylized-to-omnigen2", "latent-to-pixal3d"]
            }
        }

        def Scope "Deleted"
        {
            custom string sectionNote = "A deleted serial keeps its row. The RFDs above still cite it, and deleting a directory does not delete a citation."

            def "Retired"
            {
                custom string[] columns = ["serial int16 PK", "recorded_in int16 FK"]
                custom uniform token kind = "satellite"
                custom string primaryKey = "serial"
                custom int[] recorded_in = [1070, 1070, 1070, 1064, 1064, 1064]
                custom int[] serial = [1024, 1032, 1068, 1069, 1071, 1072]
            }
        }
    }
}

