        def Scope "Unused"
        {
            custom string sectionNote = "A serial nothing was ever written under. These three sat in neither register: not allocated to a document, and not retired from one, so a reader counting the live rows saw a gap and had nothing telling them what it meant. Recorded so the gap reads as a decision rather than as a loss. A satellite relation rather than an empty slug on the spine, because a serial with no document is a different fact from a serial with one, and CLAUDE.md's normal form takes satellites over nullable columns. NOTE THE LIMIT: `check-rfd-serials.py` keys on the scope names Allocated and Deleted and skips this one, so nothing enforces these. What prevents reuse is RFD 1000's rule that a new serial is the next unused one, which is max plus one and never a gap."

            def "NeverWritten"
            {
                custom string[] columns = ["serial int16 PK"]
                custom uniform token kind = "satellite"
                custom string primaryKey = "serial"

                def "S1081"
                {
                }
                def "S1097"
                {
                }
                def "S1127"
                {
                }
            }
        }

        def Scope "Deleted"
